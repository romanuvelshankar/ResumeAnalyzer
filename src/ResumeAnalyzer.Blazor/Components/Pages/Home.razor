@page "/"
@rendermode InteractiveServer
@using ResumeAnalyzer.Blazor.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ResumeApiClient Api
@inject NavigationManager Navigation

<PageTitle>AI Resume Analyzer</PageTitle>

<div class="hero-container">

    <div class="hero-card">

        <div class="hero-header">

            <div class="logo-circle">
                <i class="bi bi-file-earmark-person"></i>
            </div>

            <h1>AI Resume Analyzer</h1>

            <p>
                Upload your resume and receive AI-powered ATS scoring,
                skill gap analysis, career recommendations, and job matching insights.
            </p>

        </div>

        <div class="upload-container">

            <div class="upload-box">

                <i class="bi bi-cloud-arrow-up upload-icon"></i>

                <h4>Upload Resume</h4>

                <p>
                    PDF files up to 10 MB
                </p>

                <InputFile OnChange="@UploadResume"
                           class="upload-input" />

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="status-message">
                @Message
            </div>
        }

        <div class="feature-grid">

            <div class="feature-card">

                <i class="bi bi-graph-up-arrow"></i>

                <h5>ATS Score</h5>

                <p>
                    Evaluate how well your resume performs against ATS systems.
                </p>

            </div>

            <div class="feature-card">

                <i class="bi bi-search"></i>

                <h5>Skill Gap Analysis</h5>

                <p>
                    Identify missing skills and technologies employers expect.
                </p>

            </div>

            <div class="feature-card">

                <i class="bi bi-briefcase"></i>

                <h5>Job Matching</h5>

                <p>
                    Compare your resume against job descriptions instantly.
                </p>

            </div>

        </div>

    </div>

</div>

@code {

    private string? Message;

    private async Task UploadResume(
        InputFileChangeEventArgs e)
    {
        try
        {
            Message = "⏳ Uploading resume...";

            var file = e.File;

            using var stream =
                file.OpenReadStream(
                    10 * 1024 * 1024);

            using var content =
                new MultipartFormDataContent();

            content.Add(
                new StreamContent(stream),
                "resume",
                file.Name);

            var result =
                await Api.UploadResumeAsync(content);

            if (result is not null)
            {
                Message = "✅ Resume uploaded successfully";

                await Task.Delay(1000);

                Navigation.NavigateTo(
                    $"/analyze/{result.ResumeId}");
            }
        }
        catch (Exception ex)
        {
            Message = $"❌ {ex.Message}";
        }
    }
}