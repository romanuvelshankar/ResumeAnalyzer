@page "/jobs"

@using MudBlazor
@using ResumeAnalyzer.Blazor.Services
@using ResumeAnalyzer.Shared.Models
@using ResumeAnalyzer.Shared.Entities

@inject ResumeApiClient JobApi

<PageTitle>Job Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False">

    <MudText Typo="Typo.h4" Class="mb-4">
        Job Dashboard
    </MudText>

    @if (_loading)
    {
        <MudGrid Spacing="3">
            @for (var i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudSkeleton Height="340px"
                                 Width="100%"
                                 SkeletonType="SkeletonType.Rectangle" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">
            @_error
        </MudAlert>
    }
    else if (_jobs.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No jobs found.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">

            @foreach (var job in _jobs)
            {
                <MudItem xs="12" sm="6" lg="4">

                    <MudCard Class="h-100">

                        <MudCardHeader>

                            <CardHeaderContent>

                                <MudText Typo="Typo.h6">
                                    @job.Title
                                </MudText>

                                <MudText Typo="Typo.subtitle2"
                                         Color="Color.Secondary">
                                    @job.Company
                                </MudText>

                            </CardHeaderContent>

                            <CardHeaderActions>

                                @if (job.IsRemote)
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                        Remote
                                    </MudChip>
                                }

                            </CardHeaderActions>

                        </MudCardHeader>

                        <MudCardContent>

                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <MudStack Row="true"
                                          AlignItems="AlignItems.Center"
                                          Spacing="1">

                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                                             Size="Size.Small" />

                                    <MudText Typo="Typo.body2">
                                        @job.Location
                                    </MudText>

                                </MudStack>
                            }

                            <MudStack Row="true"
                                      Class="mt-2">

                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                                    @job.Source
                                </MudChip>

                            </MudStack>

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.body2">

                                @(string.IsNullOrWhiteSpace(job.Description)
                                    ? "No description available."
                                    : job.Description.Length > 220
                                        ? job.Description[..220] + "..."
                                        : job.Description)

                            </MudText>

                            @if (job.Tags.Any())
                            {
                                <MudStack Row="true"
                                          Wrap="Wrap.Wrap"
                                          Class="mt-4">

                                    @foreach (var tag in job.Tags)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                                            @tag
                                        </MudChip>
                                    }

                                </MudStack>
                            }

                        </MudCardContent>

                        <MudCardActions>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary">
                                View Details
                            </MudButton>

                            <MudSpacer />

                            <MudIconButton Icon="@Icons.Material.Filled.BookmarkBorder" />

                            <MudIconButton Icon="@Icons.Material.Filled.Share" />

                        </MudCardActions>

                    </MudCard>

                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>

@code
{
    private List<JobDashboardEntity> _jobs = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _jobs = await JobApi.JobDashboardAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}