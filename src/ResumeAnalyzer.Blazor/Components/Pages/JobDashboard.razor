@page "/jobs"
@rendermode InteractiveServer
@using MudBlazor
@using ResumeAnalyzer.Blazor.Services
@using ResumeAnalyzer.Shared.Entities

@inject ResumeApiClient JobApi

<PageTitle>Job Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <!-- HERO -->

    <MudPaper Class="dashboard-header pa-6 mb-6">

        <MudText Typo="Typo.h3" Class="fw-bold">
            👋 Find Your Next Opportunity
        </MudText>

        <MudText Typo="Typo.subtitle1">
            Discover jobs curated from multiple platforms.
        </MudText>

        <MudStack Row="true" Class="mt-4">

            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                @_jobs.Count Jobs
            </MudChip>

            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                Remote Friendly
            </MudChip>

        </MudStack>

    </MudPaper>

    <!-- SEARCH -->

    <MudPaper Elevation="0" Class="pa-4 mb-6 search-box">

        <MudTextField T="string"
                      Placeholder="Search jobs..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Immediate="true"
                      @bind-Value="_search" />

    </MudPaper>

    @if (_loading)
    {
        <MudGrid Spacing="3">

            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" lg="4">

                    <MudCard Class="pa-5 skeleton-card">

                        <MudSkeleton SkeletonType="SkeletonType.Circle"
                                     Width="60px"
                                     Height="60px" />

                        <MudSkeleton Width="80%"
                                     Height="25px"
                                     Class="mt-4" />

                        <MudSkeleton Width="50%"
                                     Height="20px" />

                        <MudSkeleton Width="100%"
                                     Height="100px"
                                     Class="mt-4" />

                    </MudCard>

                </MudItem>
            }

        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4">

            @foreach (var job in FilteredJobs)
            {
                <MudItem xs="12" sm="6" lg="4">

                    <MudCard Class="job-card d-flex flex-column h-100">

                        <MudCardHeader>

                            <CardHeaderContent>

                                <MudStack Row="true" AlignItems="AlignItems.Center">

                                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                                        @(string.IsNullOrWhiteSpace(job.Company) ? "?" : job.Company[0].ToString())
                                    </MudAvatar>

                                    <MudStack Class="ms-3">

                                        <MudText Typo="Typo.h6">
                                            @job.Title
                                        </MudText>

                                        <MudText Color="Color.Secondary">
                                            @job.Company
                                        </MudText>

                                    </MudStack>

                                </MudStack>

                            </CardHeaderContent>

                        </MudCardHeader>

                        <MudCardContent Class="flex-grow-1">

                            <MudStack Row="true" AlignItems="AlignItems.Center">

                                <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                                         Color="Color.Error" />

                                <MudText Color="Color.Secondary">
                                    @(job.IsRemote ? "Remote" : job.Location)
                                </MudText>

                            </MudStack>

                            <MudStack Row="true" Class="mt-3">

                                <MudChip T="string" Color="Color.Info">
                                    @job.Source
                                </MudChip>

                            </MudStack>

                            <MudDivider Class="my-4"/>

                            <MudExpansionPanels>
                                <MudExpansionPanel Text="Job Description">
                                    @((MarkupString)(job.Description ?? ""))
                                </MudExpansionPanel>
                            </MudExpansionPanels>

                            @if (!string.IsNullOrWhiteSpace(job.TagsSerialized))
                            {
                                <MudStack Row="true"
                                          Wrap="Wrap.Wrap"
                                          Class="mt-4">

                                    @foreach(var tag in job.TagsSerialized.Split(';'))
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Variant="Variant.Filled"
                                                 Color="Color.Primary">

                                            @tag

                                        </MudChip>
                                    }

                                </MudStack>
                            }

                        </MudCardContent>

                        <MudDivider />

                        <MudCardActions>

                        </MudCardActions>

                    </MudCard>

                </MudItem>
            }

        </MudGrid>
    }

</MudContainer>

@code{

    private List<JobDashboardEntity> _jobs = new();

    private bool _loading=true;
    private string _search="";

    IEnumerable<JobDashboardEntity> FilteredJobs =>
    _jobs.Where(j =>
        string.IsNullOrWhiteSpace(_search)
        || (j.Title?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (j.Company?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (j.Location?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (j.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (j.TagsSerialized?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
    );

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);

        _jobs = await JobApi.JobDashboardAsync();

        _loading=false;
    }

}