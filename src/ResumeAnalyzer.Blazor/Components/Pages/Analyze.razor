@page "/analyze/{ResumeId}"

@using ResumeAnalyzer.Blazor.Services
@using ResumeAnalyzer.Shared.Models

@inject ResumeApiClient Api

<PageTitle>Resume Analysis</PageTitle>

<div class="analysis-container">

    @if (_loading)
    {
        <div class="loading-card">

            <div class="spinner-border text-primary"></div>

            <h4 class="mt-3">
                Analyzing Resume...
            </h4>

            <p>
                AI is reviewing your resume and
                calculating ATS scores.
            </p>

        </div>
    }
    else if (_result is not null)
    {
        <div class="analysis-card">

            <div class="analysis-header">

                <i class="bi bi-file-earmark-check-fill"></i>

                <h1>Resume Analysis</h1>

                <p>
                    AI-powered ATS scoring and skill assessment
                </p>

            </div>

            <div class="score-card">

                <div class="score-number">
                    @_result.AtsScore
                </div>

                <div class="score-label">
                    ATS SCORE
                </div>

            </div>

            <div class="section-card">

                <h4>
                    <i class="bi bi-file-text"></i>
                    Summary
                </h4>

                <p>
                    @_result.Summary
                </p>

            </div>

            <div class="section-card">

                <h4>
                    <i class="bi bi-check-circle-fill text-success"></i>
                    Strengths
                </h4>

                <div class="tag-container">

                    @foreach (var item in _result.Strengths)
                    {
                        <span class="skill-tag success">
                            @item
                        </span>
                    }

                </div>

            </div>

            <div class="section-card">

                <h4>
                    <i class="bi bi-exclamation-circle-fill text-warning"></i>
                    Missing Skills
                </h4>

                <div class="tag-container">

                    @foreach (var item in _result.MissingSkills)
                    {
                        <span class="skill-tag warning">
                            @item
                        </span>
                    }

                </div>

            </div>

            <div class="section-card">

                <h4>
                    <i class="bi bi-lightbulb-fill text-primary"></i>
                    Recommendations
                </h4>

                <ul class="recommendation-list">

                    @foreach (var item in _result.Recommendations)
                    {
                        <li>@item</li>
                    }

                </ul>

            </div>

            <div class="text-center mt-4">

                <a href="/jobmatch/@ResumeId"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-briefcase-fill"></i>
                    Match Against Job Description

                </a>

            </div>

        </div>
    }

</div>

@code {

    [Parameter]
    public string ResumeId { get; set; } = "";

    private ResumeAnalysisResult? _result;

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _result =
            await Api.AnalyzeResumeAsync(
                ResumeId);

        _loading = false;
    }
}